# Copy to .env and fill in locally. Never commit .env.

# --- Shared connection settings -------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ehr_analytics

# --- ETL / administration (superuser; used by src/load_to_sql.py) ---------
DB_USER=postgres
DB_PASSWORD=change-me

# --- Read-only dashboard role (used by the Streamlit app) -----------------
DASHBOARD_DB_USER=ehr_dashboard
DASHBOARD_DB_PASSWORD=change-me

# --- Synthetic test database (pytest -m db) -------------------------------
# Tests connect with DB_USER/DB_PASSWORD but ONLY to this database, and refuse
# to run unless current_database() matches it.
TEST_DB_NAME=ehr_analytics_test
